"""
port_lookup.py

practicing list comprehensions + dictionaries from module 4.
just a simple lookup for common port numbers, cause i figured
id rather practice on something actually related to what im
learning in the SOC labs then a totally random example

not doing anything with real network scanning here, just
practicing python basics using networking terms i already know
"""

# dictionary of common ports and what they're used for
common_ports = {
    21: "FTP",
    22: "SSH",
    23: "Telnet",
    25: "SMTP",
    53: "DNS",
    80: "HTTP",
    443: "HTTPS",
    3389: "RDP",
    3306: "MySQL",
    8080: "HTTP Alt"
}


def lookup_port(port_number):
    if port_number in common_ports:
        return common_ports[port_number]
    else:
        return "Unknown"


# testing the lookup function
test_ports = [22, 80, 443, 9999, 3389]

print("--- port lookups ---")
for port in test_ports:
    service = lookup_port(port)
    print(f"Port {port}: {service}")


# practicing list comprehensions here
# get just the insecure/legacy ports (telnet, ftp - no encryption)
insecure_ports = [port for port, service in common_ports.items() if service in ("Telnet", "FTP")]
print(f"\nInsecure/legacy ports in this list: {insecure_ports}")

# get all port numbers as a list using comprehension instead of a loop
all_ports = [port for port in common_ports]
print(f"All known ports: {sorted(all_ports)}")

# get all the secure/encrypted-by-default ones
secure_ports = [port for port, service in common_ports.items() if service in ("SSH", "HTTPS")]
print(f"Secure ports in this list: {secure_ports}")


# quick scan simulation - just checking a list of ports against my dictionary
def scan_simulation(port_list):
    results = {}
    for port in port_list:
        results[port] = lookup_port(port)
    return results


scan_results = scan_simulation([22, 21, 443, 12345])
print("\n--- scan simulation results ---")
for port, service in scan_results.items():
    flag = "  <- unknown/unexpected" if service == "Unknown" else ""
    print(f"Port {port}: {service}{flag}")
