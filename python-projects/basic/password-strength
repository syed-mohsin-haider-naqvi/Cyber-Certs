"""
password_strength.py

practicing for loops + string methods from module 3/4.
basic password strength checker, checks for length,
uppercase, lowercase, numbers, and special characters.

figured this was more interesting to practice on then
just looping over a random list of numbers again
"""

def check_password_strength(password):
    length_ok = len(password) >= 8
    has_upper = False
    has_lower = False
    has_number = False
    has_special = False

    special_chars = "!@#$%^&*()_+-="

    # looping through each character in the string
    for char in password:
        if char.isupper():
            has_upper = True
        elif char.islower():
            has_lower = True
        elif char.isdigit():
            has_number = True
        elif char in special_chars:
            has_special = True

    checks_passed = sum([length_ok, has_upper, has_lower, has_number, has_special])

    if checks_passed == 5:
        strength = "Strong"
    elif checks_passed >= 3:
        strength = "Medium"
    else:
        strength = "Weak"

    return {
        "length_ok": length_ok,
        "has_upper": has_upper,
        "has_lower": has_lower,
        "has_number": has_number,
        "has_special": has_special,
        "strength": strength
    }


# test passwords, mix of good and bad ones
test_passwords = ["password", "Password1", "P@ssw0rd123", "abc", "MySecureP@ss99"]

for pw in test_passwords:
    result = check_password_strength(pw)
    print(f"\nPassword: {pw}")
    print(f"  Strength: {result['strength']}")
    print(f"  Length 8+: {result['length_ok']}")
    print(f"  Has uppercase: {result['has_upper']}")
    print(f"  Has lowercase: {result['has_lower']}")
    print(f"  Has number: {result['has_number']}")
    print(f"  Has special char: {result['has_special']}")
